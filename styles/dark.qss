QPushButton {
    border-radius: 6px;
    padding: 6px 6px;
    background: #555;
    color: white;
}

/* Pressed */
QPushButton:pressed {
    background: #555;
    border-color: #777;
    padding-top: 7px;
    padding-bottom: 5px;
}

QPushButton:pressed:hover {
    background: #555;
    border-color: #777;
    padding-top: 7px;
    padding-bottom: 5px;
}
/* Hover */
QPushButton:hover {
    background: #666;
    border-color: #aaa;
}

/* Checked (active / toggled on) */
QPushButton:checked {
    background: #6fa8dc; /* light blue */
    border-color: #9fc5e8;
    color: #102030;
}

/* Checked + hover */
QPushButton:checked:hover {
    background: #7fb6e8;
}

/* Checked + pressed */
QPushButton:checked:pressed {
    background: #5f98cc;
}

QPushButton:disabled {
    background: #444;
    color: #999;
    border-color: #555;
}

QPushButton[textStateOnly="true"]:checked {
    background: #555;
    color: white;
}

QPushButton[textStateOnly="true"]:disabled {
    background: #444;
    color: #999;
    border-color: #555;
}

QPushButton[textStateOnly="true"]:checked:hover {
    background: #666;
    border-color: #aaa;
}

QPushButton[textStateOnly="true"]:checked:pressed {
    background: #555;
}

QPushButton[textStateOnly="true"]:disabled {
    background: #444;
    color: white;
    border-color: #555;
}

QLineEdit {
    border-radius: 6px;
    border: 1px solid #555555 ;
    background: transparent;
}

QComboBox {
    border-radius: 6px;
    padding: 6px 10px;
    background: #555;
    color: white;
}

/* Hover: slightly lighter + stronger border */
QComboBox:hover {
    background: #666;
    border-color: #aaa;
}

/* Pressed: darker + subtle "sunken" effect */
QComboBox:pressed,
QComboBox:!editable:on {
    background: #444;
    border-color: #666;
    padding-top: 7px; /* fake press */
    padding-bottom: 5px;
}

/* Dropdown button area */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 0px solid rgba(255, 255, 255, 80);
}

/* Arrow */
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* Disabled */
QComboBox:disabled {
    background: #444;
    border-color: #555;
    color: rgba(255, 255, 255, 120);
}

QComboBox QAbstractItemView {
    background: rgba(40, 40, 40, 240);
    color: white;
    selection-background-color: rgba(120, 180, 255, 120);
    outline: none;
}

/* Bigger items = easier to tap */
QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    min-height: 28px;
}

/* Hover */
QComboBox QAbstractItemView::item:hover {
    background: rgba(255, 255, 255, 40);
}

QListView {
    background: transparent;
}
QListView::viewport {
    background: transparent;
}
QListView::item {
    padding: 5px 5px;
}
QListView::item:selected {
    background: rgba(255, 255, 255, 100);
    border-radius: 6px;
}
QListView::item:hover {
    background: rgba(102, 102, 102, 100);
    border-radius: 6px;
}
QListView::item:selected:hover {
    background: rgba(255, 255, 255, 100);
    border-radius: 6px;
}

QTableView {
    background: rgba(255, 255, 255, 40);
    gridline-color: rgba(255, 255, 255, 120);
    selection-background-color: rgba(120, 180, 255, 80);
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 8px;
}

/* ------------------------------------------------------------------
   Horizontal header
   ------------------------------------------------------------------ */

QHeaderView::section {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 rgba(255, 255, 255, 60),
        stop: 1 rgba(255, 255, 255, 20)
    );

    padding: 6px 8px;

    border: none;
    border-top: 1px solid rgba(255, 255, 255, 120);
    border-bottom: 1px solid rgba(255, 255, 255, 180);
    border-left: 1px solid rgba(255, 255, 255, 80);
    border-right: 1px solid rgba(255, 255, 255, 80);

    font-weight: 600;
}

/* Remove double border between adjacent horizontal headers */
QHeaderView::section:horizontal {
    margin-left: -1px;
}

/* Top-left / top-right corners */
QHeaderView::section:horizontal:first {
    border-top-left-radius: 7px;
}

QHeaderView::section:horizontal:last {
    border-top-right-radius: 7px;
}


/* ------------------------------------------------------------------
   Vertical header
   ------------------------------------------------------------------ */

QHeaderView::section:vertical {
    background: rgba(255, 255, 255, 20);

    border: none;
    border-right: 1px solid rgba(255, 255, 255, 80);
    border-bottom: 1px solid rgba(255, 255, 255, 80);

    padding: 4px 6px;
}

/* Bottom-left corner */
QHeaderView::section:vertical:last {
    border-bottom-left-radius: 7px;
}


/* ------------------------------------------------------------------
   Corner button
   ------------------------------------------------------------------ */

QTableCornerButton::section {
    background: transparent;
    border: none;
}

ClickableLabel {
    background-color: #444444;
    border: 1px solid #666666;
    border-radius: 20px;

    font-size: 24px;
    font-weight: bold;

    /* Default only; Python overrides this per instance */
    color: white;
}

ClickableLabel:hover {
    background-color: #555555;
}

ClickableLabel[pressed="true"] {
    background-color: #333333;
    border-color: #777777;
}

ClickableLabel[locked="true"] {
    background-color: #444444;
}

ClickableLabel[locked="true"]:hover {
    background-color: #444444;
}
