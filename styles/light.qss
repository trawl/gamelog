ClickableLabel {
    background-color: #e2e4e7;
    border: 1px solid #b8bcc2;
    border-radius: 20px;

    font-size: 24px;
    font-weight: bold;

    /* Default only; Python overrides this per instance */
    color: #202124;
}

ClickableLabel:hover {
    background-color: #d6d9dd;
}

ClickableLabel[pressed="true"] {
    background-color: #c4c8cd;
    border-color: #969ba1;
}

ClickableLabel[locked="true"] {
    background-color: #e2e4e7;
}

ClickableLabel[locked="true"]:hover {
    background-color: #e2e4e7;
}
