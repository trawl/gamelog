QPushButton {
    border-radius: 6px;
    padding: 6px 6px;
    background: #d6d9dd;
    color: #202124;
    border: 1px solid #b8bcc2;
}

/* Pressed */
QPushButton:pressed {
    background: #bfc4ca;
    border-color: #969ba1;
    padding-top: 7px;
    padding-bottom: 5px;
}

QPushButton:pressed:hover {
    background: #bfc4ca;
    border-color: #969ba1;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* Hover */
QPushButton:hover {
    background: #cdd1d6;
    border-color: #9da2a8;
}

/* Checked (active / toggled on) */
QPushButton:checked {
    background: #6fa8dc;
    border-color: #4f8fc9;
    color: #102030;
}

/* Checked + hover */
QPushButton:checked:hover {
    background: #7fb6e8;
}

/* Checked + pressed */
QPushButton:checked:pressed {
    background: #5f98cc;
}

QPushButton:disabled {
    background: #eeeeee;
    color: #aaaaaa;
    border-color: #d5d5d5;
}

QPushButton[textStateOnly="true"]:checked {
    background: #d6d9dd;
    color: #202124;
    border: 1px solid #b8bcc2;
}

QPushButton[textStateOnly="true"]:checked:hover {
    background: #cdd1d6;
}

QPushButton[textStateOnly="true"]:checked:pressed {
    background: #bfc4ca;
}

QPushButton[textStateOnly="true"]:disabled {
    background: #eeeeee;
    color: #202124;
    border-color: #d5d5d5;
}

QLineEdit {
    border-radius: 6px;
    border: 1px solid #555555 ;
    background: transparent;
}

QComboBox {
    border-radius: 6px;
    padding: 6px 10px;
    background: #d6d9dd;
    color: #202124;
    border: 1px solid #b8bcc2;
}

/* Hover */
QComboBox:hover {
    background: #cdd1d6;
    border-color: #9da2a8;
}

/* Pressed: darker + subtle "sunken" effect */
QComboBox:pressed,
QComboBox:!editable:on {
    background: #bfc4ca;
    border-color: #969ba1;
    padding-top: 7px;
    padding-bottom: 5px;
}

/* Dropdown button area */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 0px solid rgba(0, 0, 0, 40);
}

/* Arrow */
QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

/* Disabled */
QComboBox:disabled {
    background: #eeeeee;
    border-color: #d5d5d5;
    color: rgba(0, 0, 0, 100);
}

QComboBox QAbstractItemView {
    background: rgba(250, 250, 250, 245);
    color: #202020;
    selection-background-color: rgba(120, 180, 255, 120);
    outline: none;
}

/* Bigger items = easier to tap */
QComboBox QAbstractItemView::item {
    padding: 10px 12px;
    min-height: 28px;
}

/* Hover */
QComboBox QAbstractItemView::item:hover {
    background: rgba(0, 0, 0, 30);
}


QListView {
    background: transparent;
}

QListView::viewport {
    background: transparent;
}

QListView::item {
    padding: 5px 5px;
}

QListView::item:selected {
    background: rgba(0, 0, 0, 50);
    border-radius: 6px;
}

QListView::item:hover {
    background: rgba(0, 0, 0, 30);
    border-radius: 6px;
}

QListView::item:selected:hover {
    background: rgba(0, 0, 0, 50);
    border-radius: 6px;
}


QTableView {
    background: transparent;
    gridline-color: rgba(0, 0, 0, 80);
    selection-background-color: rgba(120, 180, 255, 100);
}

/* Headers */
QHeaderView::section {
    background: qlineargradient(
        x1: 0,
        y1: 0,
        x2: 0,
        y2: 1,
        stop: 0 rgba(0, 0, 0, 25),
        stop: 1 rgba(0, 0, 0, 10)
    );
    padding: 6px 8px;
    border: none;
    border-top: 1px solid rgba(0, 0, 0, 80);
    border-bottom: 1px solid rgba(0, 0, 0, 100);
    border-left: 1px solid rgba(0, 0, 0, 40);
    border-right: 1px solid rgba(0, 0, 0, 40);
    font-weight: 600;
}

/* Remove double border between adjacent headers */
QHeaderView::section:horizontal {
    margin-left: -1px;
}

/* Corner button (top-left square) */
QTableCornerButton::section {
    background: rgba(0, 0, 0, 15);
    border: 1px solid rgba(0, 0, 0, 80);
}

/* Optional: hover feedback */
